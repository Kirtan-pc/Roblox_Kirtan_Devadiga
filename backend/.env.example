# ==============================================================================
# ECHO (VECNA VERSE) ENVIRONMENT CONFIGURATION
# Dual-Stream Acoustic Paralinguistic Triage Engine for 1930 Cyber Helpline
# ==============================================================================

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dual-Stream AI Models
SER_MODEL_ID=superb/wav2vec2-base-superb-er
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MODEL_CACHE_DIR=./models_cache

# Ingestion & Buffer Settings
WINDOW_DURATION_SEC=3.0
STRIDE_DURATION_SEC=1.0
SAMPLE_RATE=16000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
